# Local development only. Production must set DEMO_MODE=false.
DEMO_MODE=true
PORT=8787

# 32 random bytes, base64 encoded. Required when DEMO_MODE=false.
CXE_ENCRYPTION_KEY=
CXE_ENCRYPTION_KEY_ID=key01

# At least 32 random bytes. Required when DEMO_MODE=false.
SESSION_SECRET=

# Copied from the installed private Zendesk app.
ZENDESK_APP_PUBLIC_KEY=
ZENDESK_APP_AUDIENCE=
ZENDESK_EXPECTED_ISSUER=

# Comma-separated Zendesk hostnames allowed to embed the service.
ZENDESK_FRAME_ANCESTORS=https://*.zendesk.com
